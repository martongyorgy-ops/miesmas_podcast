---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import categories from '../../data/categories.json';

const episodes = await getCollection('episodes');
const sorted = episodes.sort((a, b) => a.data.order - b.data.order);

function catName(key: string) {
  return (categories as Record<string, {name: string}>)[key]?.name ?? key;
}
---
<Base title="Epizódok" description="A MI és más összes eddigi adása, vendégenként böngészve.">
  <div class="wrap">
    <section>
      <p class="eyebrow">Archívum</p>
      <h1>Az összes epizód</h1>
      <p class="lead">{sorted.length} feldolgozott adás — legújabb elöl.</p>

      <div class="guest-grid">
        {sorted.map((ep) => (
          <a href={`/epizod/${ep.data.id}/`} class="guest-card">
            {ep.data.date && <span class="guest-date">{new Date(ep.data.date).toLocaleDateString('hu-HU', {year:'numeric', month:'long', day:'numeric'})}</span>}
            <span class="guest-name">{ep.data.guest}</span>
            <span class="guest-role">{ep.data.role}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
