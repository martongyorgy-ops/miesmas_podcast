---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import categories from '../../data/categories.json';
import { excerpt } from '../../lib/text';
import { relatedConcepts } from '../../lib/related';

export async function getStaticPaths() {
  const concepts = await getCollection('concepts');
  return concepts.map((c) => ({
    params: { id: c.data.id },
    props: { c },
  }));
}

const { c } = Astro.props;
const { Content } = await render(c);

const episodes = await getCollection('episodes');
const allConcepts = await getCollection('concepts');
const moreConcepts = relatedConcepts(c, allConcepts, 4);
const epById = Object.fromEntries(episodes.map((e) => [e.data.id, e]));

function catName(key: string) {
  return (categories as Record<string, {name: string}>)[key]?.name ?? key;
}
---
<Base title={c.data.name} description={excerpt(c.body) || `${c.data.name} - MI és más TudásTér`} image={`/og/fogalom/${c.data.id}.png`} type="article">
  <div class="wrap">
    <section>
      <p class="eyebrow">Fogalom · {(Array.isArray(c.data.cat) ? c.data.cat : [c.data.cat]).map(catName).join(', ')}</p>
      <h1>{c.data.name}</h1>
      <div class="lead"><Content /></div>

      <h3>Elhangzott ezekben az adásokban</h3>
      <div class="guest-grid">
        {c.data.eps.map((e: {ep: string; t: string}) => {
          const ep = epById[e.ep];
          if (!ep) return null;
          return (
            <a href={`/epizod/${ep.data.id}/`} class="guest-card">
              <span class="guest-name">{ep.data.guest}</span>
              <span class="guest-role">{ep.data.role}{e.t !== '—' ? ` · ${e.t}` : ''}</span>
            </a>
          );
        })}
      </div>

    </section>

    {moreConcepts.length > 0 && (
      <section class="related">
        <p class="eyebrow">Ez is érdekelhet</p>
        <h2>Kapcsolódó fogalmak</h2>
        <div class="concept-grid">
          {moreConcepts.map((o) => (
            <a href={`/fogalom/${o.data.id}/`} class="concept-card">
              <h3>{o.data.name}</h3>
              <p>{excerpt(o.body, 140)}</p>
            </a>
          ))}
        </div>
        <a href="/tudaster/" class="btn">Vissza a TudásTérhez</a>
      </section>
    )}
    {moreConcepts.length === 0 && (
      <section><a href="/tudaster/" class="btn">Vissza a TudásTérhez</a></section>
    )}
  </div>
</Base>
