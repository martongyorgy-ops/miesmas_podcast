---
import Base from '../../layouts/Base.astro';
import IsmerkedesBox from '../../components/IsmerkedesBox.astro';
import { getCollection } from 'astro:content';
import categories from '../../data/categories.json';

const concepts = await getCollection('concepts');
const episodes = await getCollection('episodes');
const epById = Object.fromEntries(episodes.map((e) => [e.data.id, e.data]));

const conceptsData = concepts
  .map((c) => ({
    id: c.data.id,
    name: c.data.name,
    cats: Array.isArray(c.data.cat) ? c.data.cat : [c.data.cat],
    def: c.body.trim(),
    eps: c.data.eps.map((e) => ({
      ep: e.ep,
      t: e.t,
      guest: epById[e.ep]?.guest ?? e.ep,
    })),
  }))
  .sort((a, b) => a.name.localeCompare(b.name, 'hu'));

const catEntries = Object.entries(categories as Record<string, {name: string; color: string}>);

// Tématárcsa: az "Összes" a tárcsa tetején, a többi téma óramutató járása szerint körben
const dialTopics = [
  { key: 'all', name: 'Összes téma', color: '#4A5175', count: conceptsData.length },
  ...catEntries.map(([key, val]) => ({
    key,
    name: val.name,
    color: val.color,
    count: conceptsData.filter((c) => c.cats.includes(key)).length,
  })),
].map((t, i, arr) => {
  const step = 360 / arr.length;
  const rad = ((i * step - 90) * Math.PI) / 180;
  return {
    ...t,
    i,
    angle: i * step,
    // címkék helye asztali nézetben (600×440 px-es terület, középpont: 300, 220)
    x: Math.round(300 + Math.cos(rad) * 225),
    y: Math.round(220 + Math.sin(rad) * 183),
    // színes pontok a tárcsa körül (a 300×300-as tárcsadoboz %-ában)
    dx: (50 + Math.cos(rad) * 43).toFixed(2),
    dy: (50 + Math.sin(rad) * 43).toFixed(2),
  };
});

const episodesData = episodes.map((e) => ({
  id: e.data.id,
  guest: e.data.guest,
  role: e.data.role,
  cat: e.data.cats[0] ?? '',
  summary: e.body.trim(),
}));
---
<Base title="TudásTér" description="Fogalomgyűjtemény a MI és más adásaiból — tematizálva, kereshetően, epizódokon átívelve.">
  <div class="wrap">
    <section>
      <p class="eyebrow">A műsor tudásbázisa</p>
      <h1>TudásTér</h1>
      <p class="lead">Fogalomgyűjtemény a műsorokban elhangzottak alapján — a Claude által tematizálva, kereshetően, az epizódokon átívelően, vagy éppen az epizódokat összekapcsolva.</p>

      <IsmerkedesBox />

      <div class="search-row" style="margin:24px 0 6px; position:relative;">
        <label for="search" style="display:block; font-weight:600; margin-bottom:8px;">Keresés a fogalomtárban</label>
        <input id="search" type="text" placeholder="pl. Shadow AI, hallucináció, kvantum…"
          style="width:100%; padding:14px 16px; border-radius:10px; border:1px solid var(--line-strong); background:var(--paper-raised); font-size:16px; color:var(--ink);">
      </div>
      <p id="resultCount" style="font-size:14.5px; color:var(--ink-faint);" aria-live="polite"></p>

      <section class="dial-section" aria-label="Témák szerinti szűrés">
        <div class="dial-stage">
          <div class="dial-box">
            {dialTopics.map((t) => (
              <span class="dial-dot" data-i={t.i} aria-hidden="true"
                style={`left:${t.dx}%; top:${t.dy}%; background:${t.color};`}></span>
            ))}
            <div class="dial" aria-hidden="true">
              <div class="dial-rotor" id="dialRotor">
                <span class="dial-notch" id="dialNotch"></span>
              </div>
              <svg class="dial-text" viewBox="0 0 200 200">
                <defs><path id="dialArc" d="M 22 100 A 78 78 0 0 0 178 100"></path></defs>
                <text><textPath href="#dialArc" startOffset="50%" text-anchor="middle">MI ÉS MÁS · TUDÁSTÉR</textPath></text>
              </svg>
            </div>
            <div class="dial-face" role="status" aria-live="polite">
              <span class="dial-count" id="dialCount">{conceptsData.length}</span>
              <span class="dial-unit">fogalom</span>
            </div>
          </div>

          <nav class="dial-topics" id="topicNav" aria-label="Témák">
            {dialTopics.map((t) => (
              <button class={`topic-pill${t.i === 0 ? ' active' : ''}`} type="button"
                data-cat={t.key} data-i={t.i} data-count={t.count} data-color={t.color}
                aria-pressed={t.i === 0 ? 'true' : 'false'}
                style={`--c:${t.color}; --x:${t.x}px; --y:${t.y}px;`}>
                <span class="pill-dot" aria-hidden="true"></span>{t.name}
              </button>
            ))}
          </nav>
        </div>
        <p class="dial-name" id="dialName">Összes téma</p>
      </section>

      <div id="episodeResults"></div>
      <h3 id="conceptsHeading" style="display:none;">Fogalmak</h3>
      <div class="concept-grid" id="conceptGrid"></div>
    </section>
  </div>

  <script type="application/json" id="conceptData" set:html={JSON.stringify(conceptsData)}></script>
  <script type="application/json" id="episodeData" set:html={JSON.stringify(episodesData)}></script>
  <script is:inline>
    const data = JSON.parse(document.getElementById('conceptData').textContent);
    const episodeData = JSON.parse(document.getElementById('episodeData').textContent);
    let activeCat = 'all';
    let query = '';

    function render() {
      const q = query.toLowerCase();
      const filtered = data.filter((c) => {
        const catOk = activeCat === 'all' || c.cats.includes(activeCat);
        const epMatch = c.eps.some((e) => e.guest.toLowerCase().includes(q));
        const qOk = !q || c.name.toLowerCase().includes(q) || c.def.toLowerCase().includes(q) || epMatch;
        return catOk && qOk;
      });

      const matchedEpisodes = q
        ? episodeData.filter((e) => {
            const catOk = activeCat === 'all' || e.cat === activeCat;
            const qOk = e.guest.toLowerCase().includes(q) || e.role.toLowerCase().includes(q) || e.summary.toLowerCase().includes(q);
            return catOk && qOk;
          })
        : [];

      const totalCount = filtered.length + matchedEpisodes.length;
      document.getElementById('resultCount').textContent = query
        ? `${totalCount} találat erre: "${query}"`
        : `${filtered.length} fogalom`;

      const epContainer = document.getElementById('episodeResults');
      if (matchedEpisodes.length > 0) {
        epContainer.innerHTML = `<h3 style="margin-top:8px;">Epizódok</h3>
          <div class="guest-grid" style="margin-bottom:28px;">
            ${matchedEpisodes.map((e) => `<a href="/epizod/${e.id}/" class="guest-card">
              <span class="guest-name">${e.guest}</span>
              <span class="guest-role">${e.role}</span>
            </a>`).join('')}
          </div>`;
      } else {
        epContainer.innerHTML = '';
      }

      const grid = document.getElementById('conceptGrid');
      const heading = document.getElementById('conceptsHeading');
      if (filtered.length === 0 && matchedEpisodes.length === 0) {
        heading.style.display = 'none';
        grid.innerHTML = '<p>Nincs találat ebben a kategóriában — próbálj másik szűrést, vagy töröld a keresést.</p>';
        return;
      }
      if (filtered.length === 0) {
        heading.style.display = 'none';
        grid.innerHTML = '';
        return;
      }
      heading.style.display = (query && matchedEpisodes.length > 0) ? 'block' : 'none';
      grid.innerHTML = filtered.map((c) => {
        const epsHtml = c.eps.map((e) => `<span class="chip">${e.guest}${e.t !== '—' ? ' · ' + e.t : ''}</span>`).join('');
        return `<a href="/fogalom/${c.id}/" class="concept-card">
          <h3>${c.name}</h3>
          <p>${c.def.length > 160 ? c.def.slice(0, 160) + '…' : c.def}</p>
          <div>${epsHtml}</div>
        </a>`;
      }).join('');
    }

    document.getElementById('search').addEventListener('input', (e) => {
      query = e.target.value;
      render();
    });

    // Tématárcsa: a gomb a rövidebb úton fordul a kiválasztott témához
    const pills = document.querySelectorAll('.topic-pill');
    const stepDeg = 360 / pills.length;
    let dialIdx = 0;
    let dialRot = 0;

    function selectTopic(btn) {
      const i = Number(btn.dataset.i);
      let delta = i - dialIdx;
      if (delta > pills.length / 2) delta -= pills.length;
      if (delta < -pills.length / 2) delta += pills.length;
      dialRot += delta * stepDeg;
      dialIdx = i;

      const color = btn.dataset.cat === 'all' ? '#FF9A55' : btn.dataset.color;
      document.getElementById('dialRotor').style.transform = `rotate(${dialRot}deg)`;
      document.getElementById('dialNotch').style.background = color;
      document.getElementById('dialNotch').style.boxShadow = `0 0 10px ${color}`;
      document.getElementById('dialCount').textContent = btn.dataset.count;
      document.getElementById('dialCount').style.color = btn.dataset.color;
      document.getElementById('dialName').textContent = btn.textContent.trim();
      document.querySelectorAll('.dial-dot').forEach((d) => d.classList.toggle('on', Number(d.dataset.i) === i));

      pills.forEach((b) => {
        b.classList.toggle('active', b === btn);
        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
      });
      // mobilon a kiválasztott gomb gördüljön a látható részre
      btn.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });

      activeCat = btn.dataset.cat;
      render();
    }

    pills.forEach((btn) => btn.addEventListener('click', () => selectTopic(btn)));
    document.querySelector('.dial-dot[data-i="0"]').classList.add('on');

    render();

    // Epizódoldali témacímkéről érkezve (?tema=kulcs) azonnal az adott téma nyíljon meg
    const temaParam = new URLSearchParams(location.search).get('tema');
    const temaBtn = temaParam && document.querySelector(`.topic-pill[data-cat="${CSS.escape(temaParam)}"]`);
    if (temaBtn) {
      selectTopic(temaBtn);
      document.querySelector('.dial-section').scrollIntoView({ block: 'start' });
    }
  </script>

  <style>
    /* ---- Tématárcsa ---- */
    .dial-section{
      margin:18px 0 24px; padding:10px 0 4px; scroll-margin-top:84px;
      background:var(--paper-raised); border:1px solid var(--line); border-radius:20px;
    }
    .dial-stage{position:relative; width:600px; height:440px; margin:0 auto;}
    .dial-box{position:absolute; left:150px; top:70px; width:300px; height:300px;}

    .dial-dot{
      position:absolute; width:10px; height:10px; margin:-5px 0 0 -5px; border-radius:50%;
      opacity:.45; transition:opacity .3s, transform .3s;
    }
    .dial-dot.on{opacity:1; transform:scale(1.35);}

    .dial{
      position:absolute; left:13.333%; top:13.333%; width:73.333%; height:73.333%;
      border-radius:50%; background:#0B1240;
      box-shadow:0 10px 22px rgba(11,18,64,.28), inset 0 0 0 6px #1D2766;
    }
    html.dark .dial{background:#0B1138; box-shadow:0 10px 22px rgba(0,0,0,.35), inset 0 0 0 6px #2C3577;}
    .dial-rotor{position:absolute; inset:0; transition:transform .6s cubic-bezier(.3,1.3,.5,1);}
    .dial-notch{
      position:absolute; left:50%; top:3%; width:5%; height:9%; margin-left:-2.5%;
      border-radius:6px; background:#FF9A55; box-shadow:0 0 10px #FF9A55;
      transition:background .3s, box-shadow .3s;
    }
    .dial-text{position:absolute; inset:0; width:100%; height:100%;}
    .dial-text text{fill:#B4BADB; font-family:'Inter',sans-serif; font-size:10px; font-weight:600; letter-spacing:2.4px;}

    .dial-face{
      position:absolute; left:30%; top:30%; width:40%; height:40%; border-radius:50%;
      background:#FAF7F0; box-shadow:inset 0 2px 8px rgba(0,0,0,.18);
      display:flex; flex-direction:column; align-items:center; justify-content:center;
    }
    .dial-count{font-family:'Montserrat',sans-serif; font-size:42px; font-weight:800; line-height:1; color:#4A5175; transition:color .3s;}
    .dial-unit{font-size:12px; font-weight:600; letter-spacing:.06em; text-transform:uppercase; color:#4A5175; margin-top:4px;}

    .dial-topics{position:absolute; inset:0; pointer-events:none;}
    .dial-topics .topic-pill{
      position:absolute; left:var(--x); top:var(--y); transform:translate(-50%,-50%);
      pointer-events:auto; display:flex; align-items:center; gap:8px;
      min-height:44px; padding:6px 14px; border:1px solid transparent; border-radius:22px;
      background:none; color:var(--ink-soft); font-family:inherit; font-size:15.5px; font-weight:500;
      white-space:nowrap; cursor:pointer; transition:background .2s, color .2s;
    }
    .dial-topics .topic-pill:hover{background:var(--line); color:var(--ink);}
    .dial-topics .topic-pill.active{background:var(--c); color:#FFFFFF; font-weight:600;}
    .dial-topics .topic-pill:focus-visible{outline:2px solid var(--focus); outline-offset:2px;}
    .pill-dot{width:10px; height:10px; border-radius:50%; background:var(--c); flex:none;}
    html.dark .pill-dot, html.dark .dial-dot{filter:brightness(1.7) saturate(1.1);}
    html.dark .topic-pill.active .pill-dot{filter:none;}
    .topic-pill.active .pill-dot{background:#FFFFFF;}

    .dial-name{
      display:none; text-align:center; margin:0; font-family:'Montserrat',sans-serif;
      font-size:21px; font-weight:700; color:var(--ink);
    }

    /* Mobilon: kisebb tárcsa, alatta oldalra húzható témasor */
    @media (max-width:700px){
      .dial-section{display:flex; flex-direction:column; align-items:center; gap:8px;}
      .dial-stage{display:contents;}
      .dial-box{order:0; position:relative; left:auto; top:auto; width:240px; height:240px;}
      .dial-count{font-size:36px;}
      .dial-unit{font-size:11px;}
      .dial-topics{
        position:static; order:2; width:100%; display:flex; flex-wrap:nowrap; gap:8px;
        overflow-x:auto; padding:4px 16px 8px; scrollbar-width:none;
      }
      .dial-topics::-webkit-scrollbar{display:none;}
      .dial-topics .topic-pill{
        position:static; transform:none; flex:none;
        border-color:var(--line); background:var(--paper);
      }
      .dial-topics .topic-pill.active{border-color:var(--c); background:var(--c);}
      .dial-name{display:block; order:1; font-size:20px;}
    }
  </style>
</Base>
