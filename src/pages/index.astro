---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import categories from '../data/categories.json';
import ShareBar from '../components/ShareBar.astro';
import IsmerkedesBox from '../components/IsmerkedesBox.astro';

const episodes = await getCollection('episodes');
function compareEpisodes(a, b) {
  const aDate = a.data.date ? new Date(a.data.date).getTime() : null;
  const bDate = b.data.date ? new Date(b.data.date).getTime() : null;
  if (aDate !== null && bDate !== null) return bDate - aDate;
  if (aDate !== null && bDate === null) return -1;
  if (aDate === null && bDate !== null) return 1;
  return a.data.order - b.data.order;
}
const sorted = episodes.sort(compareEpisodes);
const latest = sorted[0];
const recent4 = sorted.slice(0, 4);

function ytEmbedUrl(url: string) {
  const match = url.match(/[?&]v=([^&]+)/) || url.match(/youtu\.be\/([^?&]+)/);
  const id = match ? match[1] : '';
  return `https://www.youtube-nocookie.com/embed/${id}`;
}
function catName(key: string) {
  return (categories as Record<string, {name: string}>)[key]?.name ?? key;
}
const { Content } = await render(latest);

// Aktualitások: a főoldalon a legutóbbi 3 hír, a többi a /hirek/ oldalon
const allNews = (await getCollection('news')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const latestNews = await Promise.all(
  allNews.slice(0, 3).map(async (item) => ({ item, Body: (await render(item)).Content }))
);
const newsDate = (d: string) => new Date(d).toLocaleDateString('hu-HU', { year: 'numeric', month: 'short', day: 'numeric' });
function spotifyEmbedUrl(url) {
  const match = url.match(/episode\/([a-zA-Z0-9]+)/);
  const id = match ? match[1] : '';
  return `https://open.spotify.com/embed/episode/${id}?utm_source=generator`;
}
---
<Base title="Főoldal">

  <div class="wrap">

    <section id="adas">
      <p class="eyebrow">Legújabb adás</p>
      {latest.data.spotify ? (
        <div class="audio-frame" style="height:152px;">
          <iframe
            src={spotifyEmbedUrl(latest.data.spotify)}
            width="100%"
            height="152"
            frameborder="0"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
            title={`${latest.data.guest} — Spotify`}
          ></iframe>
        </div>
      ) : (
        <div class="audio-frame" style="height:92px; display:flex; align-items:center; justify-content:center; font-weight:600;">
          🎧 Spotify-lejátszó — hallgasd itt (link hozzáadásra vár)
        </div>
      )}
      <div class="video-frame">
        <iframe
          src={ytEmbedUrl(latest.data.url)}
          title={`${latest.data.guest} — MI és más`}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
      <div class="ep-meta">
        {latest.data.cats.map((c: string) => <span class="badge">{catName(c)}</span>)}
      </div>
      <h1>{latest.data.guest} — {latest.data.role}</h1>
      <div class="lead"><Content /></div>
      <a href={latest.data.url} class="btn" target="_blank" rel="noopener">Megnézem YouTube-on</a>
      <ShareBar path={`/epizod/${latest.data.id}/`} title={latest.data.guest} />
    </section>

    <IsmerkedesBox />

    <section id="epizodok">
      <p class="eyebrow">Archívum</p>
      <h2>Epizódok és vendégek</h2>
      <p class="lead">Az eddigi összes MI és más.</p>
      <p class="lead">A legutóbbi epizódok.</p>

      <div class="guest-grid">
        {recent4.map((ep) => (
          <a href={`/epizod/${ep.data.id}/`} class="guest-card">
            {ep.data.date && <span class="guest-date">{new Date(ep.data.date).toLocaleDateString('hu-HU', {year:'numeric', month:'long', day:'numeric'})}</span>}
            <span class="guest-name">{ep.data.guest}</span>
            <span class="guest-role">{ep.data.role}</span>
          </a>
        ))}
      </div>
      <a href="/epizodok/" class="btn">Az összes epizód</a>
    </section>

    <section id="aktualis">
      <p class="eyebrow">Aktualitások</p>
      <h2>Mi történik éppen?</h2>
      {latestNews.map(({ item, Body }) => (
        <div class="news-item">
          <span class="news-date">{newsDate(item.data.date)}</span>
          <div class="news-body"><Body /></div>
        </div>
      ))}
      {allNews.length > latestNews.length && (
        <p style="margin-top:20px;"><a href="/hirek/">Korábbi hírek →</a></p>
      )}
    </section>

    <section id="tudaster">
      <p class="eyebrow">A műsor tudásbázisa</p>
      <h2>TudásTér</h2>
      <p class="lead">Fogalomgyűjtemény a műsorokban elhangzottak alapján — a Claude által tematizálva, kereshetően, az epizódokon átívelően, vagy éppen az epizódokat összekapcsolva.</p>
    </section>

    <section id="rolam">
      <p class="eyebrow">Rólam</p>
      <div class="profile">
        <img src="/images/marton-gyorgy.jpg" alt="Márton György portréfotója" width="180" height="180">
        <div class="profile-text">
          <h2 style="margin-bottom:10px;">Márton György</h2>
          <p>Márton György vagyok, a „MI és más — közérthetően a mesterséges intelligenciáról” műsor és podcast gazdája. Valamikor mérnöknek készültem, de a munkám, hivatásom szerint újságíró lettem és vagyok ma is.</p>
          <a href="/rolam/">Teljes életrajz</a>
        </div>
      </div>
    </section>

  </div>

  <script>
    // Külső linkek a hírekben új lapon nyíljanak meg
    document.querySelectorAll('.news-body a[href^="http"]').forEach((a) => {
      a.setAttribute('target', '_blank');
      a.setAttribute('rel', 'noopener');
    });
  </script>
</Base>
