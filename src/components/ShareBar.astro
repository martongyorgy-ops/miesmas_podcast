---
// „Tetszett a beszélgetés?” sáv: Spotify-követés, megosztás, közösségi linkek
interface Props {
  path: string;   // az oldal útvonala, pl. "/epizod/szauer-pali-ficsor/"
  title: string;  // a megosztott beszélgetés címe
}
const { path, title } = Astro.props;
const shareUrl = new URL(path, Astro.site).toString();
const enc = encodeURIComponent(shareUrl);
const spotifyShow = 'https://open.spotify.com/show/0EGs6wfWqAb2nfa23ieOpS?si=d5c0ab7231aa4c1b';
---
<div class="share-bar" data-share-url={shareUrl} data-share-title={title}>
  <p class="share-title">Tetszett a beszélgetés?</p>
  <div class="share-actions">
    <a href={spotifyShow} class="btn share-spotify" target="_blank" rel="noopener">Kövesd a műsort a Spotify-on</a>
    <button type="button" class="share-btn" data-share-open>Oszd meg</button>
  </div>
  <div class="share-options" data-share-options hidden>
    <a href={`https://www.facebook.com/sharer/sharer.php?u=${enc}`} target="_blank" rel="noopener">Facebook</a>
    <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${enc}`} target="_blank" rel="noopener">LinkedIn</a>
    <a href={`mailto:?subject=${encodeURIComponent('MI és más – ' + title)}&body=${enc}`}>E-mail</a>
    <button type="button" class="share-copy" data-share-copy>Link másolása</button>
  </div>
  <p class="share-follow">
    Kövess a <a href="https://www.linkedin.com/company/miesmas/" target="_blank" rel="noopener">LinkedInen</a>{' '}vagy a <a href="https://www.facebook.com/TkpConsulting" target="_blank" rel="noopener">Facebookon</a>!
  </p>
</div>

<style>
  .share-bar{margin:28px 0 8px;padding:22px 24px;background:var(--paper-raised);border:1px solid var(--line);border-left:4px solid var(--amber);border-radius:12px;}
  .share-title{font-family:'Fraunces',serif;font-size:21px;font-weight:600;color:var(--ink);margin:0 0 14px;}
  .share-actions{display:flex;flex-wrap:wrap;gap:12px;align-items:center;}
  .share-spotify{background:var(--amber);color:#fff;}
  :global(html.dark) .share-spotify{color:#20221F;}
  .share-btn,.share-copy{font:inherit;font-size:16px;font-weight:600;padding:11px 20px;border-radius:8px;cursor:pointer;background:transparent;color:var(--ink);border:1px solid var(--line-strong);}
  .share-btn:hover,.share-copy:hover{background:var(--paper);}
  .share-options{display:flex;flex-wrap:wrap;gap:10px 18px;align-items:center;margin-top:14px;font-size:16px;font-weight:500;}
  .share-options[hidden]{display:none;}
  .share-copy{font-size:15px;padding:7px 14px;}
  .share-follow{margin:16px 0 0;font-size:15.5px;color:var(--ink-soft);}
</style>

<script>
  document.querySelectorAll<HTMLElement>('.share-bar').forEach((bar) => {
    const url = bar.dataset.shareUrl || location.href;
    const title = bar.dataset.shareTitle || document.title;
    const options = bar.querySelector<HTMLElement>('[data-share-options]');
    const openBtn = bar.querySelector<HTMLButtonElement>('[data-share-open]');
    const copyBtn = bar.querySelector<HTMLButtonElement>('[data-share-copy]');
    const isTouch = window.matchMedia('(pointer: coarse)').matches;

    openBtn?.addEventListener('click', async () => {
      // Mobilon a telefon saját megosztás-menüje, gépen a gombsor
      if (isTouch && navigator.share) {
        try { await navigator.share({ title: `MI és más – ${title}`, url }); return; }
        catch (e) { if ((e as DOMException).name === 'AbortError') return; }
      }
      if (options) options.hidden = !options.hidden;
    });

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        copyBtn.textContent = 'Kimásolva ✓';
      } catch {
        window.prompt('Másold ki a linket:', url);
      }
      setTimeout(() => { copyBtn.textContent = 'Link másolása'; }, 2500);
    });
  });
</script>
