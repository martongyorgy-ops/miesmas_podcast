---
---
<header>
  <div class="header-inner">
    <a href="/" class="logo">MI és <span>más</span></a>
    <nav aria-label="Fő navigáció">
      <a href="/">Új adás</a>
      <a href="/epizodok/">Epizódok</a>
      <a href="/tudaster/">TudásTér</a>
      <a href="/rolam/">Rólam</a>
    </nav>
    <button class="mode-toggle" id="modeToggle" aria-pressed="false" type="button">
      <span id="modeIcon" aria-hidden="true">🌙</span> <span id="modeLabel">Sötét mód</span>
    </button>
  </div>
</header>

<script is:inline>
  (function(){
    const toggle = document.getElementById('modeToggle');
    const icon = document.getElementById('modeIcon');
    const label = document.getElementById('modeLabel');
    const isDark = document.documentElement.classList.contains('dark');
    toggle.setAttribute('aria-pressed', isDark);
    icon.textContent = isDark ? '☀️' : '🌙';
    label.textContent = isDark ? 'Világos mód' : 'Sötét mód';

    toggle.addEventListener('click', () => {
      const nowDark = document.documentElement.classList.toggle('dark');
      toggle.setAttribute('aria-pressed', nowDark);
      icon.textContent = nowDark ? '☀️' : '🌙';
      label.textContent = nowDark ? 'Világos mód' : 'Sötét mód';
      localStorage.setItem('miesmas-theme', nowDark ? 'dark' : 'light');
    });
  })();
</script>
