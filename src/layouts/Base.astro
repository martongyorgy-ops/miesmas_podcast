---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'MI és más — közérthetően a mesterséges intelligenciáról' } = Astro.props;
---
<!DOCTYPE html>
<html lang="hu">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} · MI és más</title>
  <meta name="description" content={description}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script is:inline>
    const saved = localStorage.getItem('miesmas-theme');
    if (saved === 'dark') document.documentElement.classList.add('dark');
  </script>
</head>
<body>
  <a href="#main" class="skip-link">Ugrás a tartalomra</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
</body>
</html>
